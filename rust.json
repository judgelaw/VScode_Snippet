    "トポロジカルソート": {
        "prefix": "TopSort",
        "body": [
            "// 強トポロジカルソート",
            "// 順不同なところは小さい数字を採用",
            "struct TopSort {",
            "    N:usize,",
            "    edge: Vec<Vec<usize>>,",
            "    order: Vec<usize>,",
            "    idx: Vec<usize>,",
            "}",
            "",
            "impl TopSort {",
            "",
            "    fn new(n: usize) -> Self {",
            "        Self {",
            "            N:n+1,",
            "            edge: vec![vec![]; n + 1],",
            "            order: vec![],",
            "            idx: vec![0; n + 1],",
            "        }",
            "    }",
            "",
            "    fn add_edge(&mut self, u: usize, v: usize) {",
            "        self.edge[u].push(v);",
            "        self.idx[v]+=1;",
            "    }",
            "",
            "    fn solve(&mut self) -> Option<usize> {",
            "",
            "        let mut q:BinaryHeap<Reverse<usize>>=BinaryHeap::new();",
            "        for i in 0..self.N{",
            "            if self.idx[i]==0{q.push(Reverse(i));}",
            "        }",
            "",
            "",
            "        while let Some(Reverse(s)) = q.pop() {",
            "",
            "            self.order.push(s);",
            "",
            "            for &t in &self.edge[s] {",
            "                self.idx[t]-=1;",
            "                if self.idx[t]==0{",
            "                    q.push(Reverse(t));",
            "                }",
            "            }",
            "        }",
            "",
            "        None",
            "    }",
            "}",
        ],
        "description": "強トポロジカルソート"
    },
    "ダイクストラ法": {
        "prefix": "Dijkstra",
        "body": [
            "struct Dijkstra {",
            "    edge: Vec<Vec<(usize, usize)>>, // (コスト, 行き先)",
            "    pre: Vec<Option<usize>>,",
            "    cost: Vec<usize>,",
            "    path: Vec<(usize, usize)>,",
            "}",
            "",
            "impl Dijkstra {",
            "    // usize::MAX をそのまま使うと、足し算でオーバーフローする危険があるため、",
            "    // 十分に大きく、かつ加算しても溢れない値を INF とします。",
            "    const INF: usize = usize::MAX / 2;",
            "",
            "    fn new(n: usize) -> Self {",
            "        Self {",
            "            edge: vec![vec![]; n + 1],",
            "            pre: vec![None; n + 1],",
            "            cost: vec![Self::INF; n + 1],",
            "            path: Vec::new(),",
            "        }",
            "    }",
            "",
            "    fn add_edge(&mut self, u: usize, v: usize, w: usize) {",
            "        self.edge[u].push((w, v));",
            "    }",
            "",
            "    fn solve(&mut self, start: usize, goal: usize) -> Option<usize> {",
            "        self.cost[start] = 0;",
            "        let mut pq = BinaryHeap::new();",
            "",
            "        // (コスト, 現在の頂点)",
            "        pq.push(Reverse((0, start)));",
            "",
            "        while let Some(Reverse((c, s))) = pq.pop() {",
            "            if c > self.cost[s] {",
            "                continue;",
            "            }",
            "",
            "            if s == goal {",
            "                // 経路復元",
            "                let mut curr = s;",
            "                while let Some(prev) = self.pre[curr] {",
            "                    self.path.push((prev, curr));",
            "                    curr = prev;",
            "                }",
            "                self.path.reverse();",
            "                return Some(c);",
            "            }",
            "",
            "            for &(now_c, t) in &self.edge[s] {",
            "                // usize なので負になる心配はないが、",
            "                // c + now_c が usize::MAX を超えないよう INF の設定が重要",
            "                let next_cost = c + now_c;",
            "                if next_cost < self.cost[t] {",
            "                    self.cost[t] = next_cost;",
            "                    self.pre[t] = Some(s);",
            "                    pq.push(Reverse((next_cost, t)));",
            "                }",
            "            }",
            "        }",
            "",
            "        None // 到達不能な場合は None を返す（Rustらしい設計）",
            "    }",
            "}",
        ],
        "description": "ダイクストラ法"
    },
    "ワーシャルフロイド法": {
        "prefix": "Warshall_Floyd",
        "body": [
            "fn Warshall_Floyd(edge:&[Vec<Option<usize>>]) -> Vec<Vec<Option<usize>>>{",
            "",
            "    let l=edge.len();",
            "    let mut ret=edge.to_vec();",
            "",
            "    for k in 0..l{",
            "        for i in 0..l{",
            "            if let Some(v1)=ret[i][k]{",
            "                for j in 0..l{",
            "                    if let Some(v2)=ret[k][j]{",
            "                        //与えられた辺のコストをDPテーブルに入力する",
            "                        ret[i][j]=Some(ret[i][j].map_or(v1+v2,|v3|min(v3,v1+v2)));",
            "                    }",
            "                }",
            "            }",
            "        }",
            "    }",
            "",
            "    ret",
            "}",
        ],
        "description": "ワーシャルフロイド法"
    },
    "最大流(dinic法)": {
        "prefix": "Dinic",
        "body": [
            "use std::collections::VecDeque;",
            "",
            "// 最大流",
            "// geminiさんにpythonのコードを移植していただいた",
            "#[derive(Clone, Copy, Debug)]",
            "struct Edge {",
            "    to: usize,",
            "    cap: i64,",
            "    rev: usize, // 逆辺が相手の edge[to] の何番目にあるか",
            "}",
            "",
            "struct Dinic {",
            "    n: usize,",
            "    graph: Vec<Vec<Edge>>,",
            "    depth: Vec<isize>,",
            "    iter: Vec<usize>,",
            "}",
            "",
            "impl Dinic {",
            "    fn new(n: usize) -> Self {",
            "        Self {",
            "            n,",
            "            graph: vec![vec![]; n],",
            "            depth: vec![-1; n],",
            "            iter: vec![0; n],",
            "        }",
            "    }",
            "",
            "    // sからtへ容量capの辺を張る（逆辺は容量0）",
            "    fn add_edge(&mut self, s: usize, t: usize, cap: i64) {",
            "        let s_len = self.graph[s].len();",
            "        let t_len = self.graph[t].len();",
            "        self.graph[s].push(Edge { to: t, cap, rev: t_len });",
            "        self.graph[t].push(Edge { to: s, cap: 0, rev: s_len });",
            "    }",
            "",
            "    // BFSで始点sからの最短距離（層）を計算",
            "    fn bfs(&mut self, s: usize) {",
            "        self.depth.fill(-1);",
            "        self.depth[s] = 0;",
            "        let mut q = VecDeque::new();",
            "        q.push_back(s);",
            "",
            "        while let Some(v) = q.pop_front() {",
            "            for e in &self.graph[v] {",
            "                if e.cap > 0 && self.depth[e.to] < 0 {",
            "                    self.depth[e.to] = self.depth[v] + 1;",
            "                    q.push_back(e.to);",
            "                }",
            "            }",
            "        }",
            "    }",
            "",
            "    // DFSで増加パスを探して流す（再帰版が一般的で効率的）",
            "    fn dfs(&mut self, v: usize, t: usize, f: i64) -> i64 {",
            "        if v == t {",
            "            return f;",
            "        }",
            "",
            "        // self.iter[v] で「どこまで調べたか」を記録し、無駄な走査を避ける",
            "        for i in self.iter[v]..self.graph[v].len() {",
            "            self.iter[v] = i;",
            "            let e = self.graph[v][i];",
            "            ",
            "            if e.cap > 0 && self.depth[v] < self.depth[e.to] {",
            "                let d = self.dfs(e.to, t, f.min(e.cap));",
            "                if d > 0 {",
            "                    // 順辺を減らし、逆辺を増やす",
            "                    self.graph[v][i].cap -= d;",
            "                    let rev_idx = self.graph[v][i].rev;",
            "                    self.graph[e.to][rev_idx].cap += d;",
            "                    return d;",
            "                }",
            "            }",
            "        }",
            "        0",
            "    }",
            "",
            "    fn max_flow(&mut self, s: usize, t: usize) -> i64 {",
            "        let mut flow = 0;",
            "        loop {",
            "            self.bfs(s);",
            "            if self.depth[t] < 0 {",
            "                return flow;",
            "            }",
            "            self.iter.fill(0);",
            "            loop {",
            "                let f = self.dfs(s, t, i64::MAX);",
            "                if f == 0 {",
            "                    break;",
            "                }",
            "                flow += f;",
            "            }",
            "        }",
            "    }",
            "}",
        ],
        "description": "最大流(dinic法)"
    },
    "二部マッチング": {
        "prefix": "BipartiteMatching",
        "body": [
            "// 二部マッチング",
            "// C++からgeminiさんにコード移植してもらった",
            "",
            "use std::collections::VecDeque;",
            "",
            "struct BipartiteMatching {",
            "    l_size: usize,",
            "    r_size: usize,",
            "    l2r: Vec<Option<usize>>,",
            "    r2l: Vec<Option<usize>>,",
            "    backpath: Vec<Option<usize>>,",
            "    root: Vec<Option<usize>>,",
            "    edge: Vec<Vec<usize>>,",
            "}",
            "",
            "impl BipartiteMatching {",
            "    fn new(l: usize, r: usize) -> Self {",
            "        Self {",
            "            l_size: l,",
            "            r_size: r,",
            "            l2r: vec![None; l],",
            "            r2l: vec![None; r],",
            "            backpath: vec![None; l],",
            "            root: vec![None; l],",
            "            edge: vec![vec![]; l],",
            "        }",
            "    }",
            "",
            "    fn add_edge(&mut self, s: usize, t: usize) {",
            "        self.edge[s].push(t);",
            "    }",
            "",
            "    fn match_count(&mut self) -> usize {",
            "        let mut count = 0;",
            "        let mut found = true;",
            "",
            "        while found {",
            "            found = false;",
            "            let mut q = VecDeque::new();",
            "",
            "            // 未マッチングのL側頂点を起点としてBFS開始",
            "            for i in 0..self.l_size {",
            "                if self.l2r[i].is_none() {",
            "                    self.root[i] = Some(i);",
            "                    q.push_back(i);",
            "                }",
            "            }",
            "",
            "            'outer_bfs: while let Some(s) = q.pop_front() {",
            "                // すでにそのroot（起点）から増加パスが見つかっていればスキップ",
            "                if let Some(r_idx) = self.root[s] {",
            "                    if self.l2r[r_idx].is_some() {",
            "                        continue;",
            "                    }",
            "                }",
            "",
            "                for &t in &self.edge[s] {",
            "                    match self.r2l[t] {",
            "                        // R側の頂点tが未マッチング = 増加パス発見！",
            "                        None => {",
            "                            let mut curr_t = Some(t);",
            "                            let mut curr_s = s;",
            "                            while let Some(t_idx) = curr_t {",
            "                                self.r2l[t_idx] = Some(curr_s);",
            "                                // C++の swap(L2R[s], t) 相当の処理",
            "                                let next_t = self.l2r[curr_s];",
            "                                self.l2r[curr_s] = Some(t_idx);",
            "                                curr_t = next_t;",
            "                                ",
            "                                if let Some(prev_s) = self.backpath[curr_s] {",
            "                                    curr_s = prev_s;",
            "                                }",
            "                            }",
            "                            found = true;",
            "                            count += 1;",
            "                            break 'outer_bfs;",
            "                        }",
            "                        // R側の頂点tがすでにマッチング済み = BFSを継続",
            "                        Some(matched_l) => {",
            "                            if self.backpath[matched_l].is_none() {",
            "                                self.backpath[matched_l] = Some(s);",
            "                                self.root[matched_l] = self.root[s];",
            "                                q.push_back(matched_l);",
            "                            }",
            "                        }",
            "                    }",
            "                }",
            "            }",
            "",
            "            if found {",
            "                // 各フェーズ終了後に補助配列をリセット",
            "                for i in 0..self.l_size {",
            "                    self.backpath[i] = None;",
            "                    self.root[i] = None;",
            "                }",
            "            }",
            "        }",
            "        count",
            "    }",
            "}",
        ],
        "description": "二部マッチング"
    },
    "フェニック木": {
        "prefix": "Fenwick",
        "body": [
            "struct Fenwick<T> {",
            "    n: usize,",
            "    tree: Vec<T>,",
            "    initval: T,",
            "    // 演算を保持するクロージャ",
            "    op: Box<dyn Fn(T, T) -> T>,",
            "}",
            "",
            "impl<T> Fenwick<T>",
            "where",
            "    T: Copy + Default, // 基本的な数値型を想定",
            "{",
            "    /// n: 要素数, initval: 初期値, operation: 演算クロージャ",
            "    fn new<F>(n: usize, initval: T, operation: F) -> Self",
            "    where",
            "        F: Fn(T, T) -> T + 'static,",
            "    {",
            "        Self {",
            "            n,",
            "            // 1-indexedのため n+1 サイズを確保",
            "            tree: vec![initval; n + 1],",
            "            initval,",
            "            op: Box::new(operation),",
            "        }",
            "    }",
            "",
            "    // i番目にxを適用 (1 <= i <= n)",
            "    fn add(&mut self, mut i: usize, x: T) {",
            "        assert!(1 <= i && i <= self.n);",
            "        while i <= self.n {",
            "            self.tree[i] = (self.op)(self.tree[i], x);",
            "            // i & -i を usize で安全に行う方法",
            "            i += i & i.wrapping_neg();",
            "        }",
            "    }",
            "",
            "    // [1, r] の累積結果を取得",
            "    fn sum0(&self, mut r: usize) -> T {",
            "        assert!(r <= self.n);",
            "        let mut s = self.initval;",
            "        while r > 0 {",
            "            s = (self.op)(s, self.tree[r]);",
            "            r -= r & r.wrapping_neg();",
            "        }",
            "        s",
            "    }",
            "}",
            "",
            "// 加算専用の便利なメソッド（Tが引き算可能な場合）",
            "impl<T> Fenwick<T>",
            "where",
            "    T: Copy + Default + std::ops::Sub<Output = T>,",
            "{",
            "    // [l, r] の区間和を取得 (1 <= l <= r <= n)",
            "    fn sum(&self, l: usize, r: usize) -> T {",
            "        assert!(1 <= l && l <= r && r <= self.n);",
            "        self.sum0(r) - self.sum0(l - 1)",
            "    }",
            "",
            "    // i番目の要素単体を取得",
            "    fn get(&self, i: usize) -> T {",
            "        self.sum(i, i)",
            "    }",
            "}",
            "",
            "let mut fw = Fenwick::new(N+1, 0, |a, b| a + b);",
        ],
        "description": "フェニック木"
    },
    "遅延セグメント木": {
        "prefix": "LazySegmentTree",
        "body": [
            "// gemini先生にお作り頂いた遅延セグ木",
            "",
            "struct LazySegmentTree<T, F> {",
            "    n: usize,",
            "    data: Vec<T>,",
            "    lazy: Vec<Option<F>>,",
            "    e: T,                                      // 単位元（加算なら0, 最小値ならINF）",
            "    op: fn(T, T) -> T,                         // データ同士の合成（加算、minなど）",
            "    mapping: fn(F, T, usize) -> T,             // 操作をデータに適用（第3引数は区間の幅）",
            "    composition: fn(F, F) -> F,                // 操作同士の合成（加算+加算、上書きなど）",
            "}",
            "",
            "impl<T: Clone + Copy, F: Clone + Copy> LazySegmentTree<T, F> {",
            "    fn new(",
            "        v: &[T],",
            "        e: T,",
            "        op: fn(T, T) -> T,",
            "        mapping: fn(F, T, usize) -> T,",
            "        composition: fn(F, F) -> F,",
            "    ) -> Self {",
            "        let n_orig = v.len();",
            "        let mut n = 1;",
            "        while n < n_orig { n *= 2; }",
            "        ",
            "        let mut data = vec![e; 2 * n];",
            "        for i in 0..n_orig { data[i + n] = v[i]; }",
            "        for i in (1..n).rev() { data[i] = op(data[2 * i], data[2 * i + 1]); }",
            "        ",
            "        Self { n, data, lazy: vec![None; 2 * n], e, op, mapping, composition }",
            "    }",
            "",
            "    fn push(&mut self, k: usize, l: usize, r: usize) {",
            "        if let Some(f) = self.lazy[k].take() {",
            "            if k < self.n {",
            "                self.apply_to_lazy(2 * k, f);",
            "                self.apply_to_lazy(2 * k + 1, f);",
            "            }",
            "            self.data[k] = (self.mapping)(f, self.data[k], r - l);",
            "        }",
            "    }",
            "",
            "    fn apply_to_lazy(&mut self, k: usize, f: F) {",
            "        if let Some(existing_f) = self.lazy[k] {",
            "            self.lazy[k] = Some((self.composition)(f, existing_f));",
            "        } else {",
            "            self.lazy[k] = Some(f);",
            "        }",
            "    }",
            "",
            "    pub fn apply(&mut self, a: usize, b: usize, f: F) {",
            "        self.apply_internal(a, b, f, 1, 0, self.n);",
            "    }",
            "",
            "    fn apply_internal(&mut self, a: usize, b: usize, f: F, k: usize, l: usize, r: usize) {",
            "        self.push(k, l, r);",
            "        if b <= l || r <= a { return; }",
            "        if a <= l && r <= b {",
            "            self.apply_to_lazy(k, f);",
            "            self.push(k, l, r);",
            "        } else {",
            "            let mid = (l + r) / 2;",
            "            self.apply_internal(a, b, f, 2 * k, l, mid);",
            "            self.apply_internal(a, b, f, 2 * k + 1, mid, r);",
            "            self.data[k] = (self.op)(self.data[2 * k], self.data[2 * k + 1]);",
            "        }",
            "    }",
            "",
            "    pub fn query(&mut self, a: usize, b: usize) -> T {",
            "        self.query_internal(a, b, 1, 0, self.n)",
            "    }",
            "",
            "    fn query_internal(&mut self, a: usize, b: usize, k: usize, l: usize, r: usize) -> T {",
            "        self.push(k, l, r);",
            "        if b <= l || r <= a { return self.e; }",
            "        if a <= l && r <= b { return self.data[k]; }",
            "        let mid = (l + r) / 2;",
            "        let vl = self.query_internal(a, b, 2 * k, l, mid);",
            "        let vr = self.query_internal(a, b, 2 * k + 1, mid, r);",
            "        (self.op)(vl, vr)",
            "    }",
            "}",
        ],
        "description": "抽象化遅延セグメント木"
    },
    "Trie木": {
        "prefix": "Trie",
        "body": [
            "// Trie木",
            "",
            "struct Node {",
            "    // 親ノードも持っておく",
            "    par: usize,",
            "",
            "    // 子ノードのインデックス（26文字分。なければNone）",
            "    children: [Option<usize>; 26],",
            "",
            "    // そのノードを通過する単語の数",
            "    pass_count: usize,",
            "    // そのノードで終わる単語の数",
            "    end_count: usize,",
            "}",
            "",
            "impl Node {",
            "    fn new() -> Self {",
            "        Self {",
            "            par: 0,",
            "            children: [None; 26],",
            "            pass_count: 0,",
            "            end_count: 0,",
            "        }",
            "    }",
            "}",
            "",
            "struct Trie {",
            "    nodes: Vec<Node>,",
            "}",
            "",
            "impl Trie {",
            "    fn new() -> Self {",
            "        // ルートノード（インデックス0）を作成",
            "        Self {",
            "            nodes: vec![Node::new()],",
            "        }",
            "    }",
            "",
            "    // 文字列を挿入する",
            "    fn insert(&mut self, word: &str) {",
            "        let mut curr = 0; // ルートから開始",
            "        self.nodes[curr].pass_count += 1;",
            "",
            "        for c in word.chars() {",
            "            let i = (c as u8 - b'a') as usize;",
            "            // 子ノードがなければ新しく作成",
            "            if self.nodes[curr].children[i].is_none() {",
            "                let next_idx = self.nodes.len();",
            "                self.nodes[curr].children[i] = Some(next_idx);",
            "                self.nodes.push(Node::new());",
            "            }",
            "",
            "            let next_curr = self.nodes[curr].children[i].unwrap();",
            "            self.nodes[next_curr].par = curr;",
            "            curr = next_curr;",
            "            self.nodes[curr].pass_count += 1;",
            "        }",
            "        self.nodes[curr].end_count += 1;",
            "    }",
            "",
            "    // 単語が存在するか検索する",
            "    fn search(&self, word: &str) -> bool {",
            "        let mut curr = 0;",
            "        for c in word.chars() {",
            "            let i = (c as u8 - b'a') as usize;",
            "            if let Some(next) = self.nodes[curr].children[i] {",
            "                curr = next;",
            "            } else {",
            "                return false;",
            "            }",
            "        }",
            "        self.nodes[curr].end_count > 0",
            "    }",
            "    /// 単語 word が、Trie内の「自分以外の単語」と最大で何文字一致するかを返す",
            "    fn lcp(&self, word: &str) -> usize {",
            "        let mut curr = 0;",
            "        let mut max_lcp = 0;",
            "",
            "        for (depth, b) in word.chars().enumerate() {",
            "            let i = (b as u8 - b'a') as usize;",
            "",
            "            if let Some(next_idx) = self.nodes[curr].children[i] {",
            "                // 自分以外（count が 2以上）がこのノードを通っているか？",
            "                // ※もし検索専用で、まだ word を insert していないなら > 0 で判定",
            "                if self.nodes[next_idx].pass_count > 1 {",
            "                    max_lcp = depth + 1;",
            "                    curr = next_idx;",
            "                } else {",
            "                    // 自分しか通っていない道に入ったら、これ以上 LCP は伸びない",
            "                    break;",
            "                }",
            "            } else {",
            "                // そもそも道がない",
            "                break;",
            "            }",
            "        }",
            "        max_lcp",
            "    }",
            "}",
        ],
        "description": "Trie木"
    },
    "行列転置": {
        "prefix": "transmat",
        "body": [
            "/// N行M列の行列AをM行N列に転置する",
            "fn transmat(a: &Vec<Vec<usize>>) -> Vec<Vec<usize>> {",
            "    let n = a.len();",
            "    let m = a[0].len();",
            "",
            "    let mut trans_a = vec![vec![0; n]; m];",
            "    for i in 0..n {",
            "        for j in 0..m {",
            "            trans_a[j][i] = a[i][j];",
            "        }",
            "    }",
            "    trans_a",
            "}",
        ],
        "description": "行列転置"
    },
    "行列積": {
        "prefix": "prdmat",
        "body": [
            "/// N行M列の行列AとM行K列の行列Bの行列積Cを計算する",
            "fn prdmat(a: &Vec<Vec<usize>>, b: &Vec<Vec<usize>>) -> Vec<Vec<usize>> {",
            "    let n = a.len();",
            "    let m = a[0].len();",
            "    let m1 = b.len();",
            "    let k = b[0].len();",
            "",
            "    assert_eq!(m, m1, \"Incompatible matrix dimensions\");",
            "",
            "    let tb = transmat(b);",
            "",
            "    // 行列積CはN行K列となる",
            "    let mut c = vec![vec![0; k]; n];",
            "",
            "    for i in 0..n {",
            "        for j in 0..k {",
            "            let mut temp = 0;",
            "            for l in 0..m {",
            "                // (a[i][l] * b[l][j]) % MOD を計算",
            "                // temp = (temp + val) % MOD",
            "                temp = (temp + (a[i][l] * tb[j][l]) % MOD) % MOD;",
            "            }",
            "            c[i][j] = temp;",
            "        }",
            "    }",
            "    c",
            "}",
        ],
        "description": "行列積"
    },
    "行列累乗": {
        "prefix": "reppowmat",
        "body": [
            "/// 繰り返し二乗法によって行列累乗を求める",
            "fn reppowmat(mut a: Vec<Vec<usize>>, mut n: usize) -> Vec<Vec<usize>> {",
            "    let l = a.len();",
            "    ",
            "    // 単位行列を作成",
            "    let mut ret = vec![vec![0; l]; l];",
            "    for i in 0..l {",
            "        ret[i][i] = 1;",
            "    }",
            "",
            "    while n > 0 {",
            "        if n & 1 == 1 {",
            "            ret = prdmat(&ret, &a);",
            "        }",
            "        a = prdmat(&a, &a);",
            "        n >>= 1;",
            "    }",
            "",
            "    ret",
            "}",
        ],
        "description": "行列累乗"
    },
}
