    "繰り返し二乗法": {
        "prefix": "reppow",
        "body": [
            "fn reppow(mut a: usize, mut x: i64, m: usize) -> usize {",
            "    // x==-1 ならフェルマーの小定理から逆元を計算",
            "    if x==-1 {",
            "        return reppow(a,(m-2)as i64,m);",
            "    }",
            "",
            "    let mut ret=1;",
            "    a%=m;",
            "",
            "    while x>0 {",
            "        if x&1==1{",
            "            ret=(ret*a)%m;",
            "        }",
            "        a=(a*a)%m;",
            "        x>>=1;",
            "    }",
            "",
            "    ret",
            "}",
            "",
        ],
        "description": "繰り返し二乗法"
    },
